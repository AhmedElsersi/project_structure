# Copy to `.env` and fill in. Read at COMPILE time via:
#   flutter run --dart-define-from-file=.env
# Values become `String.fromEnvironment(...)` constants (see lib/core/config/app_env.dart).
# Never put server secrets here — anything in the app binary is public.

# dev | staging | prod
APP_FLAVOR=dev

# REST API root, e.g. https://api.example.com/v1 . Leave empty in dev to use the
# built-in mock backend (assets/mocks).
BASE_URL=

# true/false — defaults to true when BASE_URL is empty.
USE_MOCKS=true

# Store links used by the update gate (placeholders).
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.example.app
IOS_STORE_URL=https://apps.apple.com/app/id0000000000

# Verbose network/bloc logs in debug builds.
VERBOSE_LOGS=false

# ---------------------------------------------------------------------------
# Tooling only (tool/*.dart, CI) — NOT read by the app.
# JSON credentials: give a file path OR the base64 of the JSON file.
#   GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
#   GOOGLE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
GOOGLE_SERVICE_ACCOUNT_JSON=
